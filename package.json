{
  "name": "structuralens-action",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "GitHub Action for StructuraLens",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.js -o dist",
    "lint": "eslint .",
    "format": "prettier --check .",
    "postinstall": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@actions/artifact": "6.2.1",
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@actions/io": "3.0.2",
    "@actions/tool-cache": "4.0.0"
  },
  "devDependencies": {
    "@vercel/ncc": "0.44.0",
    "eslint": "10.4.1",
    "prettier": "3.8.4"
  },
  "license": "MIT"
}
